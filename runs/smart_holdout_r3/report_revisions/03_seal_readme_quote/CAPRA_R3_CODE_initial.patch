+            assert x[k]==y[k]
+        for k in ('completed','total','censored','decision_gt5_count'):x[k]=int(x[k])
+    rows=rawrows
+    rawcomps=list(csv.DictReader((OUT/'comparisons.csv').open(encoding='utf8',newline='')))
+    assert len(rawcomps)==len(comps)
