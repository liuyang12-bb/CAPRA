         self.epoch = 0
         self.reference_app = self.applications[sim_config.calibrate_cluster]
         
@@ -483,11 +485,16 @@ class Job(object):
             # goodput = self.multiplier * goodput
             # slowdown for job
             goodput = goodput * self.calibration_factor
+            capra_raw_rate = float(goodput)
+            goodput *= self.capra_rho  # apply auxiliary response exactly once to training
+            capra_start = float(self.current_time)
+            capra_before = float(self.progress)
 
             # Update current epoch and progress.
             next_progress = application.get_progress(self.epoch + 1)
             if self.progress + goodput * seconds < next_progress:
                 # Used up the entire time interval without finishing an epoch.
+                self.capra_segments.append(dict(start=capra_start,seconds=float(seconds),raw_rate=capra_raw_rate,rho=float(self.capra_rho),before=capra_before,after=float(self.progress+goodput*seconds),rounding=False,atomic_bsz=int(self.atomic_bsz),accum_steps=int(self.accum_steps)))
                 self.progress += goodput * seconds
                 self.current_time += seconds
                 self.attained_service += seconds * sum(self.placement)
@@ -510,6 +517,7 @@ class Job(object):
                 self.completion_epoch = completion_epoch
                 if self.epoch > completion_epoch:
                     self.completion_time = self.current_time + delta
+                self.capra_segments.append(dict(start=capra_start,seconds=float(delta),raw_rate=capra_raw_rate,rho=float(self.capra_rho),before=capra_before,after=float(next_progress),rounding=True,atomic_bsz=int(self.atomic_bsz),accum_steps=int(self.accum_steps)))
                 self.progress = next_progress
                 self.best_metric = application.get_best_metric(
                     batch_size, self.epoch)
