+                e=__import__('json').loads(line);assert e['selection']['method_spec']=={k:s[k] for k in ('candidate_labels','quota_mode','allocator_mode','ram_repair_enabled')}
+                assert e['selection']['r_calls']==int('R' in s['candidate_labels'])
