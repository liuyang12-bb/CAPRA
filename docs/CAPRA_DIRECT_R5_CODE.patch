+def quantile(v,q):
+    if not v:return None
+    v=sorted(v);x=(len(v)-1)*q;i=int(x);return v[i]*(1-(x-i))+v[min(i+1,len(v)-1)]*(x-i)
+def dist(v):return dict(n=len(v),median=quantile(v,.5),p95=quantile(v,.95),p99=quantile(v,.99),max=max(v)) if v else None
+def fmt(x):return '—' if x is None else f'{x:.6f}'
