+                rounds.append(dict(case=kind,round=r['round'],jobs=len(r['plan']),D_status=sel['D_status'],selected=sel['selected'],F_phi=fcan['score']['phi'],D_phi=dcan.get('score',{}).get('phi'),selected_minus_F=sel['relative_to_F'],decision_seconds=r['decision_seconds'],placement_seconds=sel['candidate_seconds'],placement_budget_overrun=sel['budget_overrun_seconds'],solve_requests=sel['counts']['solve_requests'],cold_solves=sel['counts']['cold_solves'],cache_hits=sel['counts']['cache_hits'],dp_checks=sel['counts']['dp_checks'],response_queries=sel['counts']['response_queries']))
+        global_counts.update(local)
+        summaries.append(dict(case=kind,status=a['status'],submitted=s['submitted'],arrived=s['arrived'],completed=s['completed'],unfinished=s['unfinished'],rounds=s['rounds'],algorithm_counts_nonempty=dict(local),algorithm_counts_all=s['algorithm_counts_all_rounds'],decision=s['decision_distribution'],component_times=s['component_times'],body_wall_seconds=s['runner_body_wall_seconds'],owned_wall_seconds=a['process']['process_wall_seconds'],charged_wall_seconds=a['charged_seconds'],audit_seconds=s['audit_seconds'],input_hashes={k:v['sha256'] for k,v in start['inputs'].items()},commands=a['command'],output=str(d.relative_to(ROOT)),mean_jct=s['mean_jct'],p95_jct=s['p95_jct'],p99_jct=s['p99_jct'],makespan=s['makespan'],performance_scope='FIXED_FIRST8_SMOKE_NOT_PERFORMANCE_EVIDENCE'))
+    A=RUN/'analysis';A.mkdir(exist_ok=True)
+    with (A/'round_metrics.csv').open('w',encoding='utf8',newline='') as f:w=csv.DictWriter(f,list(rounds[0]));w.writeheader();w.writerows(rounds)
+    result=dict(implementation_status='IMPLEMENTATION_COMPLETE',validation_status='VALIDATION_COMPLETE',base_commit=BASE,formal_performance_experiments='NOT_RUN',tests=tests,independent_completion_test=brute,unique_R4_F_replay_states=3,test_attempts=len([a for a in b['attempts'] if a['kind']=='tests']),smoke_attempts=len([a for a in b['attempts'] if a['kind'].startswith('smoke')]),smokes=summaries,algorithm_counts_nonempty=dict(global_counts),algorithm_counts_all=dict(all_counts),decision_distribution=dist(timings),component_times={k:dist(v) for k,v in components.items()},counter_sums_nonempty=dict(counts),request_bounds=request_bounds,budget_used_seconds=b['used_seconds'],budget_remaining_seconds=b['remaining_seconds'],exceptions_in_successful_smokes=0,actual_smoke_budget_fallbacks=global_counts['budget_fallbacks'],no_background_processes=all(a['process']['cleanup']['active_after_cleanup']==0 for a in b['attempts'] if 'process' in a),no_remote_push=True)
